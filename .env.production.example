NODE_ENV=production

# Neon production branch: pooled and direct connections to the SAME database/managed owner.
# Deployment-injected secrets take precedence; no physical environment file is required.
DATABASE_URL="postgresql://NEON_USER:NEON_PASSWORD@PRODUCTION_POOLER_HOST/NEON_DATABASE?sslmode=verify-full"
DIRECT_DATABASE_URL="postgresql://NEON_USER:NEON_PASSWORD@PRODUCTION_DIRECT_HOST/NEON_DATABASE?sslmode=verify-full"
