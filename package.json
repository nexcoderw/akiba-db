{
  "name": "@nexcoderw/akiba-db",
  "version": "0.2.0",
  "description": "Akiba Database: PostgreSQL schema, Prisma client, and NestJS database foundation for a multi-tenant inventory SaaS platform",
  "license": "UNLICENSED",
  "author": "NEXCODE LTD",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexcoderw/akiba-db.git"
  },
  "bugs": {
    "url": "https://github.com/nexcoderw/akiba-db/issues"
  },
  "homepage": "https://github.com/nexcoderw/akiba-db#readme",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "clean": "rimraf dist",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "migration:status": "node scripts/database-command.mjs development status",
    "migration:deploy": "node scripts/database-command.mjs development deploy",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.cjs --selectProjects unit --runInBand",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.cjs --selectProjects unit --runInBand",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "prepack": "npm run build",
    "migration:diff": "node scripts/database-command.mjs development diff",
    "migration:check": "node scripts/database-command.mjs development check",
    "migration:production:status": "node scripts/database-command.mjs production status",
    "migration:production:check": "node scripts/database-command.mjs production check",
    "migration:production:deploy": "node scripts/database-command.mjs production deploy"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/testing": "^11.1.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.15.5",
    "dotenv": "^17.2.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "prettier": "^3.4.2",
    "prisma": "^7.10.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.1",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0"
  }
}
