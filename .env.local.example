NODE_ENV=development

# Neon development branch: pooled and direct connections to the SAME database/managed owner.
# Copy the exact URLs from Neon. Approve its direct hostname in neon.environments.json.
DATABASE_URL="postgresql://NEON_USER:NEON_PASSWORD@DEVELOPMENT_POOLER_HOST/NEON_DATABASE?sslmode=require"
DIRECT_DATABASE_URL="postgresql://NEON_USER:NEON_PASSWORD@DEVELOPMENT_DIRECT_HOST/NEON_DATABASE?sslmode=require"
